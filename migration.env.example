# Copy to migrations/<name>/migration.env (gitignored, chmod 600), or create
# the migration in the web UI, which writes this file for you.
# Passed to the sandbox with --env-file; never baked into the image.

# Heroku: `heroku config:get DATABASE_URL -a <app>`
HEROKU_DATABASE_URL=postgres://user:password@host.compute-1.amazonaws.com:5432/dbname
# Render: the EXTERNAL database URL (Dashboard > Database > Connections)
RENDER_DATABASE_URL=postgresql://user:password@dpg-xxxx-a.oregon-postgres.render.com/dbname

# Bucardo sync/relgroup name: letters, digits, underscores.
SYNC_NAME=migrate
# Comma-separated schemas to migrate.
SCHEMAS=public

# Optional: post watchdog restarts and cutover completion to Slack.
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
